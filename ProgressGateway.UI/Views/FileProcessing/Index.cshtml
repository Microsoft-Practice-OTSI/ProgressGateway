@{
    ViewData["Title"] = "File Processing";
}

<style>

    .progress-page {
        max-width: 800px;
        margin-top: 30px;
    }

    /*
            IMPORTANT:
            Hide the complete progress area when the page loads.
            It will be displayed only after clicking Start.
        */
    #progressSection {
        display: none;
    }

    .progress-container {
        margin-top: 25px;
    }

    .progress-bar-container {
        width: 100%;
        height: 28px;
        background-color: #e9ecef;
        border-radius: 5px;
        overflow: hidden;
        border: 1px solid #ced4da;
    }

    .progress-bar-inner {
        width: 0%;
        height: 100%;
        background-color: #0d6efd;
        transition: width 0.4s ease;
        color: white;
        text-align: center;
        line-height: 28px;
        font-size: 14px;
        font-weight: bold;
    }

        .progress-bar-inner.failed {
            background-color: #dc3545;
        }

    .progress-message {
        margin-top: 12px;
        font-size: 15px;
        color: #555;
        min-height: 25px;
    }

    .step-list {
        list-style: none;
        padding: 0;
        margin-top: 25px;
    }

    .step-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px;
        margin-bottom: 8px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background-color: #ffffff;
    }

    .step-left {
        display: flex;
        align-items: center;
    }

    .step-icon {
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background-color: #adb5bd;
        margin-right: 12px;
    }

    .step-name {
        font-size: 15px;
    }

    .step-status {
        font-size: 14px;
        color: #6c757d;
    }


    /* =========================
           PENDING
           ========================= */

    .step-item.pending .step-icon {
        background-color: #adb5bd;
    }


    /* =========================
           IN PROGRESS
           ========================= */

    .step-item.inprogress .step-icon {
        background-color: #0d6efd;
        animation: pulse 1s infinite;
    }

    .step-item.inprogress .step-name {
        color: #0d6efd;
        font-weight: bold;
    }

    .step-item.inprogress .step-status {
        color: #0d6efd;
        font-weight: bold;
    }


    /* =========================
           COMPLETED
           ========================= */

    .step-item.completed .step-icon {
        background-color: #198754;
    }

    .step-item.completed .step-name {
        color: #198754;
    }

    .step-item.completed .step-status {
        color: #198754;
        font-weight: bold;
    }


    /* =========================
           FAILED
           ========================= */

    .step-item.failed .step-icon {
        background-color: #dc3545;
    }

    .step-item.failed .step-name {
        color: #dc3545;
        font-weight: bold;
    }

    .step-item.failed .step-status {
        color: #dc3545;
        font-weight: bold;
    }


    @@keyframes pulse {

        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }

        100% {
            opacity: 1;
        }
    }

</style>


<div class="progress-page">

    <h1>File Processing</h1>

    <p>
        Click Start to begin the file processing workflow.
    </p>

    <hr />

    <!-- START BUTTON -->

    <button id="btnStart"
            type="button"
            class="btn btn-primary">

        Start File Processing

    </button>


    <!-- =========================================
         PROGRESS SECTION

         Initially hidden.

         JavaScript will show this section after
         clicking the Start button.
         ========================================= -->

    <div id="progressSection">

        <div class="progress-container">


            <!-- =========================
                 PROGRESS BAR
                 ========================= -->

            <div class="progress-bar-container">

                <div id="progressBar"
                     class="progress-bar-inner">

                    0%

                </div>

            </div>


            <!-- =========================
                 CURRENT MESSAGE
                 ========================= -->

            <div id="progressMessage"
                 class="progress-message">

                Waiting to start...

            </div>


            <!-- =========================
                 PROCESS STEPS
                 ========================= -->

            <ul class="step-list">


                <!-- STEP 1 -->

                <li id="step-ValidateFile"
                    class="step-item pending">

                    <div class="step-left">

                        <span class="step-icon"></span>

                        <span class="step-name">

                            Validate File

                        </span>

                    </div>

                    <span class="step-status">

                        Pending

                    </span>

                </li>


                <!-- STEP 2 -->

                <li id="step-UploadFile"
                    class="step-item pending">

                    <div class="step-left">

                        <span class="step-icon"></span>

                        <span class="step-name">

                            Upload File

                        </span>

                    </div>

                    <span class="step-status">

                        Pending

                    </span>

                </li>


                <!-- STEP 3 -->

                <li id="step-ProcessFile"
                    class="step-item pending">

                    <div class="step-left">

                        <span class="step-icon"></span>

                        <span class="step-name">

                            Process File

                        </span>

                    </div>

                    <span class="step-status">

                        Pending

                    </span>

                </li>


                <!-- STEP 4 -->

                <li id="step-SaveResult"
                    class="step-item pending">

                    <div class="step-left">

                        <span class="step-icon"></span>

                        <span class="step-name">

                            Save Result

                        </span>

                    </div>

                    <span class="step-status">

                        Pending

                    </span>

                </li>

            </ul>

        </div>

    </div>

</div>


@section Scripts
{

    <!-- SignalR Client -->

    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>


    <script>

        // ==========================================
        // SIGNALR CONNECTION
        // ==========================================

        let connection = null;


        // ==========================================
        // START BUTTON
        // ==========================================

        document
            .getElementById("btnStart")
            .addEventListener(
                "click",
                async function () {

                    const button =
                        document.getElementById(
                            "btnStart"
                        );


                    // Disable button to prevent
                    // multiple simultaneous requests.

                    button.disabled = true;


                    // ==================================
                    // SHOW PROGRESS SECTION
                    //
                    // This is the main change.
                    // ==================================

                    document
                        .getElementById(
                            "progressSection"
                        )
                        .style.display = "block";


                    // ==================================
                    // RESET PROGRESS UI
                    // ==================================

                    resetProgress();


                    // ==================================
                    // GENERATE UNIQUE EXECUTION ID
                    // ==================================

                    const executionId =
                        generateExecutionId();


                    console.log(
                        "Execution ID:",
                        executionId
                    );


                    try {

                        // ==================================
                        // CONNECT TO SIGNALR
                        // ==================================

                        await connectSignalR(
                            executionId
                        );


                        // ==================================
                        // CALL MVC CONTROLLER
                        //
                        // FileProcessingController.Start()
                        // ==================================

                        const response =
                            await fetch(
                                "/FileProcessing/Start",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/json"
                                    },

                                    body: JSON.stringify({
                                        executionId:
                                            executionId
                                    })
                                }
                            );


                        if (!response.ok) {

                            throw new Error(
                                "Unable to start file processing."
                            );

                        }


                        const result =
                            await response.json();


                        console.log(
                            "Process Start Response:",
                            result
                        );


                        if (!result.success) {

                            throw new Error(
                                result.message ||
                                "Unable to start file processing."
                            );

                        }

                    }
                    catch (error) {

                        console.error(
                            "Error:",
                            error
                        );


                        document
                            .getElementById(
                                "progressMessage"
                            )
                            .innerText =
                            "Error starting file processing: "
                            + error.message;


                        button.disabled = false;

                    }

                }
            );


        // ==========================================
        // CONNECT TO SIGNALR
        // ==========================================

        async function connectSignalR(
            executionId
        ) {

            // If a previous connection exists,
            // stop it before creating a new one.

            if (connection) {

                try {

                    await connection.stop();

                }
                catch (error) {

                    console.warn(
                        "Error stopping previous connection:",
                        error
                    );

                }

            }


            // ======================================
            // CREATE SIGNALR CONNECTION
            // ======================================

            connection =
                new signalR.HubConnectionBuilder()

                    .withUrl(
                        window
                            .progressGatewayConfig
                            .apiBaseUrl
                        + "/progressHub"
                    )

                    .withAutomaticReconnect()

                    .build();


            // ======================================
            // RECEIVE PROGRESS UPDATE
            // ======================================

            connection.on(
                "ReceiveProgressUpdate",
                function (data) {

                    console.log(
                        "Progress Update:",
                        data
                    );


                    updateProgressUI(
                        data
                    );

                }
            );


            // ======================================
            // PROCESS COMPLETED
            // ======================================

            connection.on(
                "ProgressCompleted",
                function (data) {

                    console.log(
                        "Process Completed:",
                        data
                    );


                    document
                        .getElementById(
                            "progressMessage"
                        )
                        .innerText =
                        data.message ||
                        "Process completed successfully.";


                    document
                        .getElementById(
                            "btnStart"
                        )
                        .disabled = false;

                }
            );


            // ======================================
            // RECONNECTING
            // ======================================

            connection.onreconnecting(
                function () {

                    console.log(
                        "SignalR reconnecting..."
                    );

                }
            );


            // ======================================
            // RECONNECTED
            //
            // Rejoin the execution group.
            // ======================================

            connection.onreconnected(
                async function () {

                    console.log(
                        "SignalR reconnected."
                    );


                    await connection.invoke(
                        "JoinExecutionGroup",
                        executionId
                    );

                }
            );


            // ======================================
            // CONNECTION CLOSED
            // ======================================

            connection.onclose(
                function (error) {

                    console.log(
                        "SignalR connection closed.",
                        error
                    );

                }
            );


            // ======================================
            // START CONNECTION
            // ======================================

            await connection.start();


            console.log(
                "SignalR Connected."
            );


            // ======================================
            // JOIN EXECUTION GROUP
            //
            // Matches:
            //
            // ProgressHub.JoinExecutionGroup()
            // ======================================

            await connection.invoke(
                "JoinExecutionGroup",
                executionId
            );


            console.log(
                "Joined Execution Group:",
                executionId
            );

        }


        // ==========================================
        // UPDATE PROGRESS UI
        // ==========================================

        function updateProgressUI(
            data
        ) {

            const step =
                data.step;

            const status =
                data.status;

            const percentage =
                data.percentage;

            const message =
                data.message;


            // ======================================
            // UPDATE PROGRESS BAR
            // ======================================

            const progressBar =
                document.getElementById(
                    "progressBar"
                );


            progressBar.style.width =
                percentage + "%";


            progressBar.innerText =
                percentage + "%";


            // Remove failed style if
            // current status is not Failed.

            if (status !== "Failed") {

                progressBar.classList.remove(
                    "failed"
                );

            }


            // ======================================
            // UPDATE MESSAGE
            // ======================================

            if (message) {

                document
                    .getElementById(
                        "progressMessage"
                    )
                    .innerText =
                    message;

            }


            // ======================================
            // GET STEP ELEMENT
            // ======================================

            const stepElement =
                document.getElementById(
                    "step-" + step
                );


            if (!stepElement) {

                console.warn(
                    "Step not found:",
                    step
                );

                return;

            }


            // ======================================
            // REMOVE PREVIOUS STATUS
            // ======================================

            stepElement.classList.remove(
                "pending",
                "inprogress",
                "completed",
                "failed"
            );


            let cssClass =
                "pending";

            let statusText =
                "Pending";


            // ======================================
            // SET NEW STATUS
            // ======================================

            switch (status) {

                case "InProgress":

                    cssClass =
                        "inprogress";

                    statusText =
                        "In Progress";

                    break;


                case "Completed":

                    cssClass =
                        "completed";

                    statusText =
                        "Completed";

                    break;


                case "Failed":

                    cssClass =
                        "failed";

                    statusText =
                        "Failed";

                    progressBar.classList.add(
                        "failed"
                    );


                    document
                        .getElementById(
                            "btnStart"
                        )
                        .disabled = false;

                    break;


                default:

                    cssClass =
                        "pending";

                    statusText =
                        "Pending";

                    break;

            }


            // ======================================
            // APPLY STATUS
            // ======================================

            stepElement.classList.add(
                cssClass
            );


            stepElement
                .querySelector(
                    ".step-status"
                )
                .innerText =
                statusText;


            // ======================================
            // PROCESS COMPLETED
            // ======================================

            if (
                percentage === 100 &&
                status === "Completed"
            ) {

                document
                    .getElementById(
                        "btnStart"
                    )
                    .disabled = false;

            }

        }


        // ==========================================
        // RESET PROGRESS UI
        // ==========================================

        function resetProgress() {

            const progressBar =
                document.getElementById(
                    "progressBar"
                );


            // Reset progress bar

            progressBar.style.width =
                "0%";


            progressBar.innerText =
                "0%";


            progressBar.classList.remove(
                "failed"
            );


            // Reset message

            document
                .getElementById(
                    "progressMessage"
                )
                .innerText =
                "Starting file processing...";


            // Reset all steps

            const steps = [

                "ValidateFile",

                "UploadFile",

                "ProcessFile",

                "SaveResult"

            ];


            steps.forEach(
                function (step) {

                    const element =
                        document.getElementById(
                            "step-" + step
                        );


                    element.classList.remove(
                        "inprogress",
                        "completed",
                        "failed"
                    );


                    element.classList.add(
                        "pending"
                    );


                    element
                        .querySelector(
                            ".step-status"
                        )
                        .innerText =
                        "Pending";

                }
            );

        }


        // ==========================================
        // GENERATE EXECUTION ID
        // ==========================================

        function generateExecutionId() {

            return crypto.randomUUID();

        }

    </script>

}