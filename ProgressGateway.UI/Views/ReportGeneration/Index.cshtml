@{
    ViewData["Title"] = "Report Generation";
}

<div class="container mt-4">

    <h2>Report Generation</h2>

    <p class="text-muted">
        Click Start to begin the report generation process.
    </p>

    <hr />

    <!-- =====================================================
         START BUTTON
    ====================================================== -->

    <button id="btnStart"
            type="button"
            class="btn btn-primary">
        Start Report Generation
    </button>


    <!-- =====================================================
         PROGRESS SECTION

         Initially hidden.
    ====================================================== -->

    <div id="progressSection"
         style="display:none; margin-top:20px;">

        <!-- Progress Bar -->

        <div class="progress"
             style="height:25px;">

            <div id="progressBar"
                 class="progress-bar"
                 role="progressbar"
                 style="width:0%;"
                 aria-valuenow="0"
                 aria-valuemin="0"
                 aria-valuemax="100">

                <span id="progressPercentage">
                    0%
                </span>

            </div>

        </div>


        <!-- Current Message -->

        <div id="progressMessage"
             class="mt-3 mb-3">

            Waiting to start...

        </div>


        <!-- =================================================
             STEPS
        ================================================== -->

        <div id="stepContainer">

            <div id="step-ValidateRequest"
                 class="border rounded p-3 mb-2 step-item">

                <span>
                    <strong>• Validate Request</strong>
                </span>

                <span class="float-end step-status">
                    Pending
                </span>

            </div>


            <div id="step-CollectData"
                 class="border rounded p-3 mb-2 step-item">

                <span>
                    <strong>• Collect Data</strong>
                </span>

                <span class="float-end step-status">
                    Pending
                </span>

            </div>


            <div id="step-GenerateReport"
                 class="border rounded p-3 mb-2 step-item">

                <span>
                    <strong>• Generate Report</strong>
                </span>

                <span class="float-end step-status">
                    Pending
                </span>

            </div>


            <div id="step-SaveReport"
                 class="border rounded p-3 mb-2 step-item">

                <span>
                    <strong>• Save Report</strong>
                </span>

                <span class="float-end step-status">
                    Pending
                </span>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        // =====================================================
        // SIGNALR CONNECTION
        // =====================================================

        var connection =
            new signalR.HubConnectionBuilder()
                .withUrl(
                    window.progressGatewayConfig.apiBaseUrl
                    + "/progressHub"
                )
                .withAutomaticReconnect()
                .build();


        // =====================================================
        // RECEIVE PROGRESS UPDATE
        // =====================================================

        connection.on(
            "ReceiveProgressUpdate",
            function (data) {

                console.log(
                    "Progress Update Received:",
                    data
                );

                updateProgress(data);

            }
        );


        // =====================================================
        // START SIGNALR CONNECTION
        // =====================================================

        async function startSignalR() {

            try {

                await connection.start();

                console.log(
                    "SignalR connected."
                );

            }
            catch (error) {

                console.error(
                    "SignalR connection failed:",
                    error
                );

                setTimeout(
                    startSignalR,
                    3000
                );

            }

        }


        // =====================================================
        // START BUTTON
        // =====================================================

        document
            .getElementById("btnStart")
            .addEventListener(
                "click",
                async function () {

                    var button = this;

                    try {

                        button.disabled = true;


                        // -----------------------------------------
                        // Show progress section
                        // -----------------------------------------

                        document
                            .getElementById("progressSection")
                            .style.display = "block";


                        resetProgress();


                        // -----------------------------------------
                        // Create Execution ID
                        // -----------------------------------------

                        var executionId =
                            crypto.randomUUID();

                        console.log(
                            "Execution ID:",
                            executionId
                        );


                        // -----------------------------------------
                        // Join SignalR Group FIRST
                        // -----------------------------------------

                        await connection.invoke(
                            "JoinExecutionGroup",
                            executionId
                        );

                        console.log(
                            "Joined Execution Group:",
                            executionId
                        );


                        // -----------------------------------------
                        // Call MVC Controller
                        // -----------------------------------------

                        document
                            .getElementById("progressMessage")
                            .innerText =
                            "Report generation started...";


                        var response =
                            await fetch(
                                "/ReportGeneration/Start",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/json"
                                    },

                                    body:
                                        JSON.stringify({
                                            executionId:
                                                executionId
                                        })
                                }
                            );


                        var result =
                            await response.json();


                        console.log(
                            "Process Start Response:",
                            result
                        );


                        if (!result.success) {

                            throw new Error(
                                result.message ||
                                "Unable to start report generation."
                            );

                        }

                    }
                    catch (error) {

                        console.error(
                            "Error:",
                            error
                        );


                        document
                            .getElementById("progressMessage")
                            .innerText =
                            "Error starting report generation: "
                            + error.message;


                        button.disabled = false;

                    }

                }
            );


        // =====================================================
        // UPDATE UI
        // =====================================================

        function updateProgress(data) {

            var progressBar =
                document.getElementById(
                    "progressBar"
                );

            var percentage =
                data.percentage || 0;


            // ---------------------------------------------
            // Update progress bar
            // ---------------------------------------------

            progressBar.style.width =
                percentage + "%";


            progressBar.setAttribute(
                "aria-valuenow",
                percentage
            );


            document
                .getElementById("progressPercentage")
                .innerText =
                percentage + "%";


            // ---------------------------------------------
            // Update message
            // ---------------------------------------------

            document
                .getElementById("progressMessage")
                .innerText =
                data.message || "";


            // ---------------------------------------------
            // Find step
            // ---------------------------------------------

            var stepElement =
                document.getElementById(
                    "step-" + data.step
                );


            if (!stepElement) {

                console.warn(
                    "Step not found:",
                    data.step
                );

                return;

            }


            var statusElement =
                stepElement.querySelector(
                    ".step-status"
                );


            // ---------------------------------------------
            // Remove previous classes
            // ---------------------------------------------

            stepElement.classList.remove(
                "bg-primary",
                "bg-success",
                "bg-danger",
                "text-white"
            );


            // ---------------------------------------------
            // IN PROGRESS
            // ---------------------------------------------

            if (data.status === "InProgress") {

                stepElement.classList.add(
                    "bg-primary",
                    "text-white"
                );

                statusElement.innerText =
                    "In Progress...";

            }


            // ---------------------------------------------
            // COMPLETED
            // ---------------------------------------------

            if (data.status === "Completed") {

                stepElement.classList.add(
                    "bg-success",
                    "text-white"
                );

                statusElement.innerText =
                    "Completed";

            }


            // ---------------------------------------------
            // FAILED
            // ---------------------------------------------

            if (data.status === "Failed") {

                stepElement.classList.add(
                    "bg-danger",
                    "text-white"
                );

                statusElement.innerText =
                    "Failed";

                document
                    .getElementById("btnStart")
                    .disabled = false;

            }


            // ---------------------------------------------
            // PROCESS COMPLETED
            // ---------------------------------------------

            if (percentage === 100 &&
                data.status === "Completed") {

                document
                    .getElementById("btnStart")
                    .disabled = false;

            }

        }


        // =====================================================
        // RESET PROGRESS
        // =====================================================

        function resetProgress() {

            document
                .getElementById("progressBar")
                .style.width = "0%";


            document
                .getElementById("progressPercentage")
                .innerText = "0%";


            document
                .getElementById("progressMessage")
                .innerText =
                "Waiting to start...";


            var steps =
                document.querySelectorAll(
                    ".step-item"
                );


            steps.forEach(
                function (step) {

                    step.classList.remove(
                        "bg-primary",
                        "bg-success",
                        "bg-danger",
                        "text-white"
                    );


                    step
                        .querySelector(".step-status")
                        .innerText =
                        "Pending";

                }
            );

        }


        // =====================================================
        // INITIALIZE SIGNALR
        // =====================================================

        startSignalR();

    </script>
}