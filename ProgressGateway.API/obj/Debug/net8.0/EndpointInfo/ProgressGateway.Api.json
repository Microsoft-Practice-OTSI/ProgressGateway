{
  "openapi": "3.0.1",
  "info": {
    "title": "ProgressGateway.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/Progress/update": {
      "post": {
        "tags": [
          "Progress"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProgressUpdateRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ProgressUpdateRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ProgressUpdateRequest"
              }
            }
          }
