      "ProgressUpdateRequest": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "nullable": true
          },
          "step": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
