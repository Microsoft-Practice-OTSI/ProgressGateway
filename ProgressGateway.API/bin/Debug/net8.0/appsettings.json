{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    // Shared symmetric secret key (Must be >= 256 bits / 32 characters in production)
    "SecretKey": "ThisIsASecretKeyForProgressGatewayAppMinimum32BytesLong!",
    // Identifies the authorization server that issued the token
    "Issuer": "ProgressGateway.Api",
    // Identifies the intended recipients / consumers of the token
    "Audience": "ProgressGatewayClients",
    // Token validity lifetime in minutes
    "ExpiryMinutes": 120
  }
}